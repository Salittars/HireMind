# Copy to .env and fill in ONE key to get generated answers. Leave empty for the
# no-key extractive mode (everything still works). Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# auto (=hybrid, falls back to tfidf) | hybrid | sentence-transformers | tfidf
JOBRAG_EMBEDDER=auto
JOBRAG_EMBED_MODEL=intfloat/multilingual-e5-small
# Use the committed sample instead of live data:
# JOBRAG_RAW_DIR=data/sample
